{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@config": ["src/config"],
      "@config/*": ["src/config/*"],
      "@middlewares": ["src/middlewares"],
      "@middlewares/*": ["src/middlewares/*"],
      "@plugins": ["src/plugins"],
      "@plugins/*": ["src/plugins/*"],
      "@services": ["src/services"],
      "@services/*": ["src/services/*"],
      "@shared": ["src/shared"],
      "@shared/*": ["src/shared/*"],
      "@utils": ["src/utils"],
      "@utils/*": ["src/utils/*"]
    }
  },
  "include": ["src/**/*", "src/@types/express.d.ts"],
  "exclude": ["node_modules", "dist", "src/@types/express.d.ts"]
}
